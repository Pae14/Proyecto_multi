<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--Altura del LiDAR con respecto a base_link-->
  <xacro:property name="camera_height" value="0.4"/>

  <!--link que representa el cuerpo físico del sensor-->
  <link name="$(arg prefix)camera_link">
    <visual>
      <geometry>
        <box size="0.02 0.05 0.05"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.05 0.05"/>
      </geometry>
    </collision>

    <!--Propiedades inerciales requeridas para la simulación-->
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
  </link>
  <!--Articulación uniendo la camara a la base del robot-->
  <joint name="$(arg prefix)camera_joint" type="fixed">
    <parent link="$(arg prefix)base_link"/>
    <child link="$(arg prefix)camera_link"/>
    <origin xyz="0.5 0 ${camera_height}" rpy="0 0 0"/>
  </joint>

  <!--Referencia para Gazebo-->
  <gazebo reference="$(arg prefix)camera_link">
    <sensor name="camera_sensor" type="camera">
      <update_rate>30</update_rate>
      
      <topic>$(arg prefix)camera/image_raw</topic>

      <gz_frame_id>$(arg prefix)camera_link</gz_frame_id>

      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

</robot>