<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Macro para inercia de cajas -->
  <xacro:macro name="box_inertia" params="m x y z o_xyz o_rpy">
    <inertial>
      <mass value="${m}"/>
      <origin xyz="${o_xyz}" rpy="${o_rpy}"/>
      <inertia
        ixx="${m/12.0*(y*y + z*z)}"
        ixy="0"
        ixz="0"
        iyy="${m/12.0*(x*x + z*z)}"
        iyz="0"
        izz="${m/12.0*(x*x + y*y)}"
      />
    </inertial>
  </xacro:macro>
  
  <!-- Parámetros -->
  <xacro:property name="wheel_radius" value="0.15"/>
  <xacro:property name="wheel_width" value="0.1"/>
  <xacro:property name="wheel_separation" value="0.41"/>
  <material name="black">
    <color rgba="0 0 0 1"/>
  </material>

  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>

  <material name="gray">
    <color rgba="0.5 0.5 0.5 1"/>
  </material>

  <!-- BASES -->
  <link name="$(arg prefix)base_footprint"/>

  <joint name="$(arg prefix)base_link_joint" type="fixed">
    <parent link="$(arg prefix)base_footprint"/>
    <child link="$(arg prefix)base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="$(arg prefix)base_link">
    <visual>
      <origin xyz="0 0 0.175" rpy="0 0 0"/>
      <geometry>
        <box size="1 0.7 0.35"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.175"/>
      <geometry>
        <box size="1 0.7 0.35"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0"
               iyy="0.1" iyz="0.0"
               izz="0.1"/>
    </inertial>
  </link>

  <!-- ===================== -->
  <!-- RUEDAS -->
  <!-- ===================== -->
  <link name="$(arg prefix)left_front_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.15" length="0.1"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.15" length="0.1"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
              iyy="0.001" iyz="0.0"
              izz="0.001"/>
    </inertial>
  </link>

  <link name="$(arg prefix)right_front_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.15" length="0.1"/>
      </geometry>
      <material name="black"/>
    </visual>
    
    <collision>
      <geometry>
        <cylinder radius="0.15" length="0.1"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
              iyy="0.001" iyz="0.0"
              izz="0.001"/>
    </inertial>
  </link>

  <link name="$(arg prefix)left_rear_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.15" length="0.1"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.15" length="0.1"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
              iyy="0.001" iyz="0.0"
              izz="0.001"/>
    </inertial>
  </link>

  <link name="$(arg prefix)right_rear_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.15" length="0.1"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.15" length="0.1"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
              iyy="0.001" iyz="0.0"
              izz="0.001"/>
    </inertial>
  </link>

  <joint name="$(arg prefix)left_front_wheel_joint" type="continuous">
    <parent link="$(arg prefix)base_link"/>
    <child link="$(arg prefix)left_front_wheel"/>
    <origin xyz="0.3 ${wheel_separation} 0.15" rpy="1.57 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="$(arg prefix)right_front_wheel_joint" type="continuous">
    <parent link="$(arg prefix)base_link"/>
    <child link="$(arg prefix)right_front_wheel"/>
    <origin xyz="0.3 -${wheel_separation} 0.15" rpy="1.57 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="$(arg prefix)left_rear_wheel_joint" type="continuous">
    <parent link="$(arg prefix)base_link"/>
    <child link="$(arg prefix)left_rear_wheel"/>
    <origin xyz="-0.3 ${wheel_separation} 0.15" rpy="1.57 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="$(arg prefix)right_rear_wheel_joint" type="continuous">
    <parent link="$(arg prefix)base_link"/>
    <child link="$(arg prefix)right_rear_wheel"/>
    <origin xyz="-0.3 -${wheel_separation} 0.15" rpy="1.57 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

</robot>