<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="irb120_gazebo_plugins" params="">
    <!--plugin de ros2 control para mover el brazo en gazebo-->
    <gazebo>
      <plugin filename="gz_ros2_control-system"
              name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find multi_robot_bringup)/config/controllers.yaml</parameters>
        <ros>
          <namespace>/rover</namespace>
          <remapping>/robot_description:=/rover/robot_description</remapping>
        </ros>
      </plugin>
    </gazebo>

    <!--publicar joint states-->
    <gazebo>
      <plugin filename="gz-sim-joint-state-publisher-system"
              name="gz::sim::systems::JointStatePublisher">
        <joint_name>arm_joint_1</joint_name>
        <joint_name>arm_joint_2</joint_name>
        <joint_name>arm_joint_3</joint_name>
        <joint_name>arm_joint_4</joint_name>
        <joint_name>arm_joint_5</joint_name>
        <joint_name>arm_joint_6</joint_name>
      </plugin>
    </gazebo>

    <!--desactiva las colisiones internas del brazo-->
    <gazebo reference="arm_base_link"><self_collide>false</self_collide></gazebo>
    <gazebo reference="arm_link_1"><self_collide>false</self_collide></gazebo>
    <gazebo reference="arm_link_2"><self_collide>false</self_collide></gazebo>
    <gazebo reference="arm_link_3"><self_collide>false</self_collide></gazebo>
    <gazebo reference="arm_link_4"><self_collide>false</self_collide></gazebo>
    <gazebo reference="arm_link_5"><self_collide>false</self_collide></gazebo>
    <gazebo reference="arm_link_6"><self_collide>false</self_collide></gazebo>

  </xacro:macro>

</robot>
