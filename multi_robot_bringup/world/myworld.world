<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="bosque_ruinas_final">
    
    <physics type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 30 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1.0</diffuse>
      <specular>0.2 0.2 0.2 1.0</specular>
      <direction>0.5 -0.5 -1.0</direction>
    </light>

    <include><uri>model://ground</uri><name>suelo</name></include>


    <!-- EL ROVER SE CARGA DESDE EL LAUNCH (rover_description) -->

    <!-- ROBOT DRON -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/antonytodo/models/CERBERUS_M100_SENSOR_CONFIG_1</uri>
      <name>uav_cerberus</name>
      <static>false</static>
      <pose>-5 10 0.8 0 0 0</pose>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <topic>/uav/cmd_vel</topic>
      </plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_frame>world</odom_frame>
        <robot_base_frame>uav_cerberus/base_link</robot_base_frame>
      </plugin>
    </include>
    
    <!-- OBJETOS PARA EL DATASET (Fuera de las casetas) -->
    <include><uri>model://hazardous_barrel</uri><name>barril_1</name><pose>2 15 0 0 0 0</pose></include>
    <include><uri>model://mochila</uri><name>mochila_1</name><pose>15 -9 0.2 0 0 0</pose></include>
    <include><uri>model://caja_herramientas</uri><name>caja_1</name><pose>-9 10 0.2 0 0 0</pose></include>
    <include><uri>model://hazardous_barrel</uri><name>barril_suelo</name><pose>-9 -9 0.4 0 0 0</pose></include>

    <include><uri>model://palets</uri><name>palet</name><pose>5 9 0 0 0 0.5236</pose></include>
    <include><uri>model://palets</uri><name>palet1</name><pose>4 7 0 0 0 0</pose></include>
    <include><uri>model://palets</uri><name>palet2</name><pose>4 8 0 0 0 0</pose></include>
    <include><uri>model://palets</uri><name>palet3</name><pose>5 7 0 0 0.5236 -0.5236</pose></include>
    <include><uri>model://palets</uri><name>palet4</name><pose>5 8 0 0 0.4363 -0.5236</pose></include>

    <include><uri>model://palets</uri><name>palet5</name><pose>10 1 0 0 0 0.5236</pose></include>
    <include><uri>model://palets</uri><name>palet6</name><pose>9 -1 0 0 0 0</pose></include>
    <include><uri>model://palets</uri><name>palet7</name><pose>9 0 0 0 0 0</pose></include>
    <include><uri>model://palets</uri><name>palet8</name><pose>10 -1 0 0 0.5236 -0.5236</pose></include>
    <include><uri>model://palets</uri><name>palet9</name><pose>10 0 0 0 0.4363 -0.5236</pose></include>

    <include><uri>model://chemical_tank</uri><name>tanque_quimico</name><pose>7 9 0 0 0 1.5708</pose></include>
    <include><uri>model://chemical_tank</uri><name>tanque_quimico2</name><pose>10 3 0 0 0 1.5708</pose></include>

    <include><uri>model://broken_fence_section</uri><name>broken_fence_section0</name><pose>0 -9 0 0 0 0</pose></include>
    <include><uri>model://broken_fence_section</uri><name>broken_fence_section1</name><pose>5 -9 0 0 0 0.3</pose></include>
    <include><uri>model://broken_fence_section</uri><name>broken_fence_section2</name><pose>10 -9 0 0 0 1.2</pose></include>

    <include><uri>model://broken_pipe</uri><name>broken_pipe0</name><pose>-5 -9 0 1.5708 0 1.5708</pose></include>
    <include><uri>model://debris_pile</uri><name>debris_pile0</name><pose>-5 -5 0 1.5708 0 1.5708</pose></include>

  </world>
</sdf>
